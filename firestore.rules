rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Standard Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validation Blueprints ---

    function isValidUserDiagnostic(data) {
      return data.keys().hasAll(['wpm', 'accuracy', 'score', 'maxStreak', 'category', 'difficulty', 'timestamp'])
        && data.keys().size() == 7
        && data.wpm is number && data.wpm >= 0 && data.wpm <= 300
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.score is int && data.score >= 0
        && data.maxStreak is int && data.maxStreak >= 0
        && data.category is string && data.category.size() <= 100
        && data.difficulty is string && data.difficulty.size() <= 20
        && data.timestamp is string;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['caseInsensitive', 'neonThemeColor', 'isMuted', 'focusMode', 'updatedAt'])
        && data.keys().size() == 5
        && data.caseInsensitive is bool
        && data.neonThemeColor is string && data.neonThemeColor.size() <= 20
        && data.isMuted is bool
        && data.focusMode is bool
        && data.updatedAt is string;
    }

    function isValidMatchRoom(data) {
      return data.keys().hasAll(['roomId', 'hostId', 'hostName', 'status', 'gameMode', 'createdAt', 'updatedAt'])
        && data.roomId is string && data.roomId.size() <= 128
        && data.hostId is string && data.hostId.size() <= 128
        && data.hostName is string && data.hostName.size() <= 100
        && data.status is string && (data.status == 'waiting' || data.status == 'active' || data.status == 'ended')
        && data.gameMode is string && (data.gameMode == 'duel' || data.gameMode == 'co-op')
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // --- Path Matching Rules ---

    // Personalized Diagnostic Archives & Player Preferences
    match /users/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;

      match /diagnostics/{runId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        allow create: if isSignedIn() && userId == request.auth.uid && isValidId(runId) && isValidUserDiagnostic(request.resource.data);
        allow update, delete: if false; // Archive records are immutable historical logs
      }

      match /settings/{controlsId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        allow write: if isSignedIn() && userId == request.auth.uid && isValidId(controlsId) && isValidUserSettings(request.resource.data);
      }
    }

    // Multiplayer Matchmaking Lobbies
    match /matchrooms/{roomId} {
      allow read: if isSignedIn() && isValidId(roomId);
      allow create: if isSignedIn() && isValidId(roomId) 
                    && isValidMatchRoom(request.resource.data)
                    && request.resource.data.hostId == request.auth.uid;
      
      // Updates are allowed to update player telemetry, guest joinees, and glitches
      allow update: if isSignedIn() && isValidId(roomId)
                    && (resource.data.hostId == request.auth.uid || resource.data.guestId == request.auth.uid || request.resource.data.guestId == request.auth.uid)
                    && isValidMatchRoom(request.resource.data);
                    
      allow delete: if isSignedIn() && isValidId(roomId) && resource.data.hostId == request.auth.uid;
    }
  }
}
